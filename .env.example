# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# Africa's Talking. Development uses the sandbox app, whose username is
# literally "sandbox"; production uses your live app's username.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Alphanumeric SMS sender ID registered with AT (optional; blank = default)
AFRICASTALKING_SENDER_ID=Elimu

# Claude, for test generation (ticket #8) and question clustering (ticket #9).
ANTHROPIC_API_KEY=

# Leave unset for local SQLite (server/elimutayari.db). Setting this to an
# empty value overrides that default with an empty URL, so keep it commented
# out rather than blank. Production supplies Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/elimutayari
